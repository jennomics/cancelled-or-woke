# Serper Google Search API. One value is required.
# Key: sign up at https://serper.dev and copy your API key.
# Do not commit a real key. In Vercel, add this same name under
# Project Settings -> Environment Variables (Production).
SERPER_API_KEY=
# Optional. Override only for local testing against a mock server.
# SERPER_API_URL=https://google.serper.dev/search
