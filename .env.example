# Google Programmable Search JSON API. Both are required.
# Key: https://console.cloud.google.com/apis/credentials (enable "Custom Search API")
# Engine ID: https://programmablesearchengine.google.com/ (set it to search the entire web)
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
# Optional. Override only for local testing against a mock server.
# GOOGLE_SEARCH_API_URL=https://www.googleapis.com/customsearch/v1
# Required. Anyone opening the page must enter this to search.
APP_PASSWORD=
